{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "EventLog": {
      "LogLevel": {
        "Default": "None"
      }
    }
  },
  "AlmacenamientoArchivos": {
    "RutaBase": ""
  },
  "DataProtection": {
    "KeysPath": "",
    "ProtectionMode": "Dpapi"
  },
  "Proxy": {
    "ForwardedHeadersEnabled": false,
    "KnownProxies": [
      "127.0.0.1",
      "::1"
    ]
  },
  "FuncionesFinancierasExperimentales": {
    "PlanillaDemostrativaHabilitada": false,
    "ForecastExperimentalHabilitado": false
  },
  "ModoDemoAcademica": {
    "Habilitado": false
  },
  "AllowedHosts": "*"
}
