@page "/Account/Manage/PersonalData"

@using Microsoft.AspNetCore.Identity
@using SIGECDC.Persistence.Identity

@inject UserManager<ApplicationUser> UserManager
@inject IdentityRedirectManager RedirectManager

<PageTitle>Datos personales</PageTitle>

<StatusMessage />
<h3>Datos personales</h3>

<div class="row">
    <div class="col-md-6">
        <p>Su cuenta contiene datos personales proporcionados al sistema. Esta página permite descargar la copia actualmente disponible.</p>
        <form action="Account/Manage/DescargarPersonalData" method="post">
            <AntiforgeryToken />
            <button class="btn btn-primary" type="submit">Descargar</button>
        </form>
        <div class="alert alert-info mt-3" role="alert">
            <strong>La eliminación de cuentas no está disponible.</strong>
            <p class="mb-0">
                La administración de la cuenta debe gestionarse mediante el proceso administrativo autorizado.
            </p>
        </div>
    </div>
</div>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        var user  = await UserManager.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
        }
    }
}
