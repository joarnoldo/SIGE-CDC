@page "/Account/Manage/PersonalData"

@using Microsoft.AspNetCore.Identity
@using SIGECDC.Persistence.Identity

@inject UserManager<ApplicationUser> UserManager
@inject IdentityRedirectManager RedirectManager

<PageTitle>Datos personales</PageTitle>

<StatusMessage />
<h3>Datos personales</h3>

<div class="row">
    <div class="col-md-6">
        <p>Su cuenta contiene datos personales proporcionados al sistema. Esta página permite descargarlos o eliminarlos.</p>
        <p>
            <strong>Al eliminar estos datos, la cuenta se cerrará de forma permanente y no podrá recuperarse.</strong>
        </p>
        <form action="Account/Manage/DescargarPersonalData" method="post">
            <AntiforgeryToken />
            <button class="btn btn-primary" type="submit">Descargar</button>
        </form>
        <p>
            <a href="Account/Manage/DeletePersonalData" class="btn btn-danger">Eliminar</a>
        </p>
    </div>
</div>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        var user  = await UserManager.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
        }
    }
}
