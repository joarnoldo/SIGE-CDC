@page "/rrhh/incidencias-planilla/{IdIncidenciaPlanilla:long}"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Administrador,Recursos Humanos")]
@using SIGECDC.Application.Planillas
@inject IIncidenciaPlanillaService IncidenciaPlanillaService
@inject AuthenticationStateProvider Autenticacion
@inject ILogger<EditarIncidenciaPlanilla> Logger

<PageTitle>Editar incidencia de planilla | SIGE-CDC</PageTitle>

<section class="page-banner">
    <div class="container page-banner__inner stack--tight">
        <p class="eyebrow">Recursos Humanos / Planillas</p>
        <h1>Ficha de incidencia.</h1>
        <p class="lead">Consulte y actualice una incidencia registrada para el período de planilla.</p>
    </div>
</section>

<section class="section-shell">
    <div class="container page-grid">
        <section class="page-main">
            @if (!string.IsNullOrWhiteSpace(mensajeEstado))
            {
                <div class="alert alert--@(mensajeEsError ? "danger" : "success")" role="alert">
                    <strong>@(mensajeEsError ? "No se pudo completar la acción" : "Acción completada")</strong>
                    <span>@mensajeEstado</span>
                </div>
            }

            @if (cargando)
            {
                <div class="empty-state">
                    <strong>Cargando incidencia</strong>
                    <p class="text-muted">Estamos recuperando el registro solicitado.</p>
                </div>
            }
            else if (incidencia is null)
            {
                <div class="empty-state">
                    <strong>Incidencia no encontrada</strong>
                    <p class="text-muted">El registro solicitado no existe en el sistema.</p>
                    <a class="btn btn--secondary" href="rrhh/incidencias-planilla">Volver al listado</a>
                </div>
            }
            else if (string.Equals(incidencia.EstadoRegistro, "Inactivo", StringComparison.OrdinalIgnoreCase))
            {
                <div class="empty-state">
                    <strong>Incidencia inactiva</strong>
                    <p class="text-muted">El registro está conservado para consulta, pero no permite cambios.</p>
                    <a class="btn btn--secondary" href="rrhh/incidencias-planilla">Volver al listado</a>
                </div>
            }
            else if (incidencia.EstaBloqueada)
            {
                <div class="empty-state">
                    <strong>Período bloqueado</strong>
                    <p class="text-muted">
                        La incidencia se conserva para consulta, pero no puede modificarse porque la planilla está en estado @incidencia.EstadoPlanilla.
                    </p>
                    <a class="btn btn--secondary" href="rrhh/incidencias-planilla">Volver al listado</a>
                </div>
            }
            else
            {
                <EditForm Model="solicitud" OnValidSubmit="GuardarAsync" OnInvalidSubmit="LimpiarMensaje" class="stack">
                    <DataAnnotationsValidator />
                    <ValidationSummary />

                    <IncidenciaPlanillaFormularioCampos Solicitud="solicitud"
                                                        Periodos="periodos"
                                                        Colaboradores="colaboradores"
                                                        TiposIncidencia="tiposIncidencia" />

                    <div class="form-actions">
                        <a class="btn btn--secondary" href="rrhh/incidencias-planilla">Volver</a>
                        <div class="page-actions">
                            <button class="btn btn--danger"
                                    type="button"
                                    disabled="@NoPuedeDesactivar"
                                    @onclick="DesactivarAsync">
                                Desactivar
                            </button>
                            <button class="btn btn--primary" type="submit" disabled="@guardando">
                                @(guardando ? "Guardando..." : "Guardar cambios")
                            </button>
                        </div>
                    </div>
                </EditForm>
            }
        </section>

        <aside class="page-aside">
            <article class="card card--accent stack">
                <p class="eyebrow">Resumen</p>
                <h2>@(incidencia?.TipoIncidencia ?? "Incidencia")</h2>
                <div class="metric-list">
                    <div class="metric-row"><span>Período</span><strong>@(incidencia?.CodigoPeriodo ?? "-")</strong></div>
                    <div class="metric-row"><span>Colaborador</span><strong>@(incidencia?.NombreColaborador ?? "-")</strong></div>
                    <div class="metric-row"><span>Naturaleza</span><strong>@(incidencia?.Naturaleza ?? "-")</strong></div>
                    <div class="metric-row"><span>Estado</span><strong>@(incidencia?.EstadoRegistro ?? "-")</strong></div>
                </div>
            </article>
            <article class="card stack">
                <h3>Desactivación</h3>
                <p>La desactivación conserva el registro y lo excluye como incidencia vigente.</p>
            </article>
        </aside>
    </div>
</section>

@code {
    [Parameter]
    public long IdIncidenciaPlanilla { get; set; }

    private SolicitudIncidenciaPlanilla solicitud = new();
    private IncidenciaPlanillaDetalle? incidencia;
    private IReadOnlyList<PeriodoPlanillaOpcion> periodos = [];
    private IReadOnlyList<ColaboradorIncidenciaOpcion> colaboradores = [];
    private IReadOnlyList<TipoIncidenciaPlanillaOpcion> tiposIncidencia = [];
    private bool cargando = true;
    private bool guardando;
    private bool desactivando;
    private bool mensajeEsError;
    private string? mensajeEstado;

    private bool NoPuedeDesactivar => desactivando
        || incidencia is null
        || incidencia.EstaBloqueada
        || string.Equals(incidencia.EstadoRegistro, "Inactivo", StringComparison.OrdinalIgnoreCase);

    protected override async Task OnParametersSetAsync()
    {
        await CargarAsync();
    }

    private async Task CargarAsync()
    {
        cargando = true;

        periodos = await IncidenciaPlanillaService.ObtenerPeriodosAsync();
        colaboradores = await IncidenciaPlanillaService.ObtenerColaboradoresAsync();
        tiposIncidencia = await IncidenciaPlanillaService.ObtenerTiposIncidenciaAsync();
        incidencia = await IncidenciaPlanillaService.ObtenerIncidenciaPorIdAsync(IdIncidenciaPlanilla);

        if (incidencia is not null)
        {
            solicitud = new SolicitudIncidenciaPlanilla
            {
                IdPeriodoPlanilla = incidencia.IdPeriodoPlanilla,
                IdColaborador = incidencia.IdColaborador,
                IdTipoIncidenciaPlanilla = incidencia.IdTipoIncidenciaPlanilla,
                FechaIncidencia = incidencia.FechaIncidencia,
                Cantidad = incidencia.Cantidad,
                Monto = incidencia.Monto,
                Descripcion = incidencia.Descripcion
            };
        }

        cargando = false;
    }

    private async Task GuardarAsync()
    {
        guardando = true;
        mensajeEstado = null;
        mensajeEsError = false;

        try
        {
            var idUsuarioActual = await ObtenerIdUsuarioActualAsync();
            await IncidenciaPlanillaService.ActualizarIncidenciaAsync(IdIncidenciaPlanilla, solicitud, idUsuarioActual);
            mensajeEstado = "La incidencia fue actualizada.";
            await CargarAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "No se pudo actualizar la incidencia {IdIncidenciaPlanilla}.", IdIncidenciaPlanilla);
            mensajeEsError = true;
            mensajeEstado = ex.Message;
        }
        finally
        {
            guardando = false;
        }
    }

    private async Task DesactivarAsync()
    {
        desactivando = true;
        mensajeEstado = null;
        mensajeEsError = false;

        try
        {
            await IncidenciaPlanillaService.DesactivarIncidenciaAsync(IdIncidenciaPlanilla);
            mensajeEstado = "La incidencia fue marcada como Inactiva.";
            await CargarAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "No se pudo desactivar la incidencia {IdIncidenciaPlanilla}.", IdIncidenciaPlanilla);
            mensajeEsError = true;
            mensajeEstado = ex.Message;
        }
        finally
        {
            desactivando = false;
        }
    }

    private void LimpiarMensaje()
    {
        mensajeEstado = null;
        mensajeEsError = false;
    }

    private async Task<string?> ObtenerIdUsuarioActualAsync()
    {
        var estadoAutenticacion = await Autenticacion.GetAuthenticationStateAsync();
        return estadoAutenticacion.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    }
}
