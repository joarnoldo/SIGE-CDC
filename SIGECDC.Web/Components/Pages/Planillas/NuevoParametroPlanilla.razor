@page "/rrhh/parametros-planilla/nuevo"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Administrador,Recursos Humanos")]
@using SIGECDC.Application.Planillas
@inject IParametroPlanillaService ParametroPlanillaService
@inject AuthenticationStateProvider Autenticacion
@inject NavigationManager Navegacion
@inject ILogger<NuevoParametroPlanilla> Logger

<PageTitle>Nuevo parámetro de planilla | SIGE-CDC</PageTitle>

<section class="page-banner">
    <div class="container page-banner__inner stack--tight">
        <p class="eyebrow">Recursos Humanos / Planillas</p>
        <h1>Nuevo parámetro de planilla.</h1>
        <p class="lead">Registre valores configurables para deducciones, beneficios o referencias internas.</p>
    </div>
</section>

<section class="section-shell">
    <div class="container page-grid">
        <section class="page-main">
            @if (!string.IsNullOrWhiteSpace(mensajeError))
            {
                <div class="alert alert--danger" role="alert">
                    <strong>No se pudo registrar el parámetro</strong>
                    <span>@mensajeError</span>
                </div>
            }

            @if (cargando)
            {
                <div class="empty-state">
                    <strong>Cargando formulario</strong>
                    <p class="text-muted">Estamos preparando los tipos de parámetro.</p>
                </div>
            }
            else
            {
                <EditForm Model="solicitud" OnValidSubmit="GuardarAsync" OnInvalidSubmit="LimpiarMensaje" class="stack">
                    <DataAnnotationsValidator />
                    <ValidationSummary />

                    <ParametroPlanillaFormularioCampos Solicitud="solicitud"
                                                       TiposParametro="tiposParametro"
                                                       NaturalezasParametro="naturalezasParametro" />

                    <div class="form-actions">
                        <a class="btn btn--secondary" href="rrhh/parametros-planilla">Volver</a>
                        <button class="btn btn--primary" type="submit" disabled="@guardando">
                            @(guardando ? "Guardando..." : "Registrar parámetro")
                        </button>
                    </div>
                </EditForm>
            }
        </section>

        <aside class="page-aside">
            <article class="card card--accent stack">
                <p class="eyebrow">Configuración global</p>
                <h2>Valores de planilla</h2>
                <p>Los parámetros registrados quedan disponibles como referencia para procesos posteriores de planilla.</p>
            </article>
            <article class="card stack">
                <h3>Código único</h3>
                <p>Use un código claro y estable para identificar el parámetro dentro del sistema.</p>
            </article>
        </aside>
    </div>
</section>

@code {
    private SolicitudParametroPlanilla solicitud = new();
    private IReadOnlyList<TipoParametroPlanillaOpcion> tiposParametro = [];
    private IReadOnlyList<NaturalezaParametroPlanillaOpcion> naturalezasParametro = [];
    private bool cargando = true;
    private bool guardando;
    private string? mensajeError;

    protected override async Task OnInitializedAsync()
    {
        tiposParametro = await ParametroPlanillaService.ObtenerTiposParametroAsync();
        naturalezasParametro = await ParametroPlanillaService.ObtenerNaturalezasParametroAsync();
        solicitud.TipoParametro = tiposParametro.FirstOrDefault()?.Nombre ?? "Porcentaje";
        cargando = false;
    }

    private async Task GuardarAsync()
    {
        guardando = true;
        mensajeError = null;

        try
        {
            var idUsuarioActual = await ObtenerIdUsuarioActualAsync();
            var idParametro = await ParametroPlanillaService.RegistrarParametroAsync(solicitud, idUsuarioActual);
            Navegacion.NavigateTo($"rrhh/parametros-planilla/{idParametro}");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "No se pudo registrar el parámetro de planilla.");
            mensajeError = ex.Message;
        }
        finally
        {
            guardando = false;
        }
    }

    private void LimpiarMensaje()
    {
        mensajeError = null;
    }

    private async Task<string?> ObtenerIdUsuarioActualAsync()
    {
        var estadoAutenticacion = await Autenticacion.GetAuthenticationStateAsync();
        return estadoAutenticacion.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    }
}
