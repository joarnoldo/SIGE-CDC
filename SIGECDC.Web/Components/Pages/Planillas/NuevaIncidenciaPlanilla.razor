@page "/rrhh/incidencias-planilla/nueva"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Recursos Humanos")]
@using SIGECDC.Application.Planillas
@inject IIncidenciaPlanillaService IncidenciaPlanillaService
@inject AuthenticationStateProvider Autenticacion
@inject NavigationManager Navegacion
@inject ILogger<NuevaIncidenciaPlanilla> Logger

<PageTitle>Nueva incidencia de planilla | SIGE-CDC</PageTitle>

<section class="page-banner">
    <div class="container page-banner__inner stack--tight">
        <p class="eyebrow">Recursos Humanos / Planillas</p>
        <h1>Nueva incidencia de planilla.</h1>
        <p class="lead">Registre novedades del período para mantener el control de planilla.</p>
    </div>
</section>

<section class="section-shell">
    <div class="container page-grid">
        <section class="page-main">
            @if (!string.IsNullOrWhiteSpace(mensajeError))
            {
                <div class="alert alert--danger" role="alert">
                    <strong>No se pudo registrar la incidencia</strong>
                    <span>@mensajeError</span>
                </div>
            }

            @if (cargando)
            {
                <div class="empty-state">
                    <strong>Cargando formulario</strong>
                    <p class="text-muted">Estamos preparando los catálogos de planilla.</p>
                </div>
            }
            else if (periodos.Count == 0)
            {
                <div class="empty-state">
                    <strong>No hay períodos disponibles</strong>
                    <p class="text-muted">Se requiere un período de planilla existente para registrar incidencias.</p>
                    <a class="btn btn--secondary" href="rrhh/incidencias-planilla">Volver al listado</a>
                </div>
            }
            else
            {
                <EditForm Model="solicitud" OnValidSubmit="GuardarAsync" OnInvalidSubmit="LimpiarMensaje" class="stack">
                    <DataAnnotationsValidator />
                    <ValidationSummary />

                    <IncidenciaPlanillaFormularioCampos Solicitud="solicitud"
                                                        Periodos="periodos"
                                                        Colaboradores="colaboradores"
                                                        TiposIncidencia="tiposIncidencia" />

                    <div class="form-actions">
                        <a class="btn btn--secondary" href="rrhh/incidencias-planilla">Volver</a>
                        <button class="btn btn--primary" type="submit" disabled="@guardando">
                            @(guardando ? "Guardando..." : "Registrar incidencia")
                        </button>
                    </div>
                </EditForm>
            }
        </section>

        <aside class="page-aside">
            <article class="card card--accent stack">
                <p class="eyebrow">Registro operativo</p>
                <h2>Incidencias del período</h2>
                <p>La fecha de incidencia debe estar dentro del rango del período seleccionado.</p>
            </article>
            <article class="card stack">
                <h3>Control previo</h3>
                <p>Este registro no ejecuta cálculos de planilla; conserva la novedad para procesos posteriores.</p>
            </article>
        </aside>
    </div>
</section>

@code {
    private SolicitudIncidenciaPlanilla solicitud = new();
    private IReadOnlyList<PeriodoPlanillaOpcion> periodos = [];
    private IReadOnlyList<ColaboradorIncidenciaOpcion> colaboradores = [];
    private IReadOnlyList<TipoIncidenciaPlanillaOpcion> tiposIncidencia = [];
    private bool cargando = true;
    private bool guardando;
    private string? mensajeError;

    protected override async Task OnInitializedAsync()
    {
        periodos = await IncidenciaPlanillaService.ObtenerPeriodosAsync();
        colaboradores = await IncidenciaPlanillaService.ObtenerColaboradoresAsync();
        tiposIncidencia = await IncidenciaPlanillaService.ObtenerTiposIncidenciaAsync();

        var periodo = periodos.FirstOrDefault();
        solicitud.IdPeriodoPlanilla = periodo?.Id ?? 0;
        solicitud.FechaIncidencia = periodo?.FechaInicio ?? DateTime.Today;
        solicitud.IdColaborador = colaboradores.FirstOrDefault()?.Id ?? 0;
        solicitud.IdTipoIncidenciaPlanilla = tiposIncidencia.FirstOrDefault()?.Id ?? 0;

        cargando = false;
    }

    private async Task GuardarAsync()
    {
        guardando = true;
        mensajeError = null;

        try
        {
            var idUsuarioActual = await ObtenerIdUsuarioActualAsync();
            var idIncidencia = await IncidenciaPlanillaService.RegistrarIncidenciaAsync(solicitud, idUsuarioActual);
            Navegacion.NavigateTo($"rrhh/incidencias-planilla/{idIncidencia}");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "No se pudo registrar la incidencia de planilla.");
            mensajeError = ex.Message;
        }
        finally
        {
            guardando = false;
        }
    }

    private void LimpiarMensaje()
    {
        mensajeError = null;
    }

    private async Task<string?> ObtenerIdUsuarioActualAsync()
    {
        var estadoAutenticacion = await Autenticacion.GetAuthenticationStateAsync();
        return estadoAutenticacion.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    }
}
