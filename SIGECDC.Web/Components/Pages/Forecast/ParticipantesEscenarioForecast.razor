@page "/rrhh/forecast/{IdForecastEscenario:long}/participantes"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Recursos Humanos")]
@using System.ComponentModel.DataAnnotations
@using SIGECDC.Application.Forecast
@inject IForecastParticipanteService ForecastParticipanteService
@inject AuthenticationStateProvider Autenticacion
@inject ILogger<ParticipantesEscenarioForecast> Logger

<PageTitle>Colaboradores forecast | SIGE-CDC</PageTitle>

<section class="page-banner">
    <div class="container page-banner__inner stack--tight">
        <p class="eyebrow">Recursos Humanos / Forecast</p>
        <h1>Composición de colaboradores.</h1>
        <p class="lead">Defina qué colaboradores reales formarán parte del escenario sin alterar sus expedientes.</p>
    </div>
</section>

<section class="section-shell">
    <div class="container stack">
        @if (!string.IsNullOrWhiteSpace(mensajeError))
        {
            <div class="alert alert--danger" role="alert">
                <strong>No se pudo guardar la composición</strong>
                <span>@mensajeError</span>
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(mensajeExito))
        {
            <div class="alert alert--success" role="status">
                <strong>Composición actualizada</strong>
                <span>@mensajeExito</span>
            </div>
        }

        <div class="page-header">
            <div>
                <p class="eyebrow">Participantes reales</p>
                <h2>@(configuracion?.NombreEscenario ?? "Escenario no disponible")</h2>
            </div>
            <div class="page-actions">
                <a class="btn btn--secondary" href="@($"rrhh/forecast/{IdForecastEscenario}")">Volver al detalle</a>
            </div>
        </div>

        @if (cargando)
        {
            <div class="empty-state">
                <strong>Cargando colaboradores</strong>
                <p class="text-muted">Estamos evaluando expedientes, catálogos y contratos vigentes.</p>
            </div>
        }
        else if (configuracion is null)
        {
            <div class="empty-state">
                <strong>Escenario no encontrado</strong>
                <p class="text-muted">El escenario solicitado no existe o no está activo.</p>
                <a class="btn btn--primary" href="rrhh/forecast">Ver escenarios</a>
            </div>
        }
        else
        {
            <section class="kpi-grid">
                <article class="stat-card">
                    <span class="stat-label">Estado</span>
                    <strong class="stat-value">@configuracion.EstadoEscenario</strong>
                    <span class="stat-delta">Estado oficial</span>
                </article>
                <article class="stat-card">
                    <span class="stat-label">Incluidos</span>
                    <strong class="stat-value">@configuracion.Participantes.Count(item => item.EstaIncluido)</strong>
                    <span class="stat-delta">Selección actual</span>
                </article>
                <article class="stat-card">
                    <span class="stat-label">Excluidos</span>
                    <strong class="stat-value">@configuracion.Participantes.Count(item => !item.EstaIncluido)</strong>
                    <span class="stat-delta">Conservados en el escenario</span>
                </article>
                <article class="stat-card">
                    <span class="stat-label">No elegibles</span>
                    <strong class="stat-value">@configuracion.Participantes.Count(item => !item.EsElegible)</strong>
                    <span class="stat-delta">Requieren revisión</span>
                </article>
            </section>

            @if (!configuracion.PuedeEditar)
            {
                <article class="alert alert--info" role="status">
                    <strong>Composición bloqueada</strong>
                    <span>Los colaboradores solo pueden modificarse mientras el escenario esté en estado Borrador.</span>
                </article>
            }

            <article class="table-card">
                <div class="table-toolbar">
                    <div>
                        <h2 class="card__title">Colaboradores del escenario</h2>
                        <p class="card__meta">La primera carga selecciona los elegibles; la persistencia ocurre únicamente al guardar.</p>
                    </div>
                    <span class="badge badge--info">@configuracion.Participantes.Count</span>
                </div>

                @if (configuracion.Participantes.Count == 0)
                {
                    <div class="empty-state">
                        <strong>No hay colaboradores disponibles</strong>
                        <p class="text-muted">No existen expedientes activos que puedan formar la composición.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>Incluir</th>
                                    <th>Colaborador</th>
                                    <th>Departamento</th>
                                    <th>Puesto</th>
                                    <th>Salario mensual</th>
                                    <th>Elegibilidad</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var participante in configuracion.Participantes)
                                {
                                    <tr @key="participante.IdColaborador">
                                        <td>
                                            <input type="checkbox"
                                                   checked="@participante.EstaIncluido"
                                                   disabled="@EstaBloqueado(participante)"
                                                   aria-label="@($"Incluir a {participante.Etiqueta}")"
                                                   @onchange="evento => CambiarInclusion(participante, evento)" />
                                        </td>
                                        <td>
                                            <strong>@participante.Etiqueta</strong>
                                            <p class="card__meta">@participante.CodigoParticipante · @(participante.EstaPersistido ? "Snapshot guardado" : "Pendiente de guardar")</p>
                                        </td>
                                        <td>@participante.Departamento</td>
                                        <td>@participante.Puesto</td>
                                        <td>@TextoSalario(participante.SalarioBaseMensual)</td>
                                        <td>
                                            @if (participante.EsElegible)
                                            {
                                                <span class="badge badge--success">Elegible</span>
                                            }
                                            else
                                            {
                                                <span class="badge badge--warning">No elegible</span>
                                                <p class="card__meta">@participante.MotivoNoElegible</p>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </article>

            @if (configuracion.PuedeEditar && configuracion.Participantes.Count > 0)
            {
                <div class="form-actions">
                    <a class="btn btn--secondary" href="@($"rrhh/forecast/{IdForecastEscenario}")">Cancelar</a>
                    <button class="btn btn--primary" type="button" disabled="@guardando" @onclick="GuardarAsync">
                        @(guardando ? "Guardando..." : "Guardar composición")
                    </button>
                </div>
            }
        }
    </div>
</section>

@code {
    [Parameter]
    public long IdForecastEscenario { get; set; }

    private ConfiguracionParticipantesForecast? configuracion;
    private bool cargando = true;
    private bool guardando;
    private string? mensajeError;
    private string? mensajeExito;

    protected override async Task OnParametersSetAsync()
    {
        cargando = true;
        LimpiarMensajes();

        try
        {
            await CargarConfiguracionAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "No se pudo cargar la composición forecast {IdForecastEscenario}.", IdForecastEscenario);
            configuracion = null;
            mensajeError = "No se pudo cargar la composición de colaboradores.";
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task GuardarAsync()
    {
        if (guardando || configuracion?.PuedeEditar != true)
        {
            return;
        }

        guardando = true;
        LimpiarMensajes();
        try
        {
            var idActor = await ObtenerIdUsuarioActualAsync();
            var solicitud = new SolicitudGuardarParticipantesForecast
            {
                Participantes = configuracion.Participantes
                    .Select(item => new SolicitudParticipanteForecast
                    {
                        IdColaborador = item.IdColaborador,
                        EstaIncluido = item.EstaIncluido
                    })
                    .ToList()
            };
            await ForecastParticipanteService.GuardarComposicionAsync(
                IdForecastEscenario,
                solicitud,
                idActor);
            await CargarConfiguracionAsync(idActor);
            mensajeExito = "La composición quedó guardada. Complete la distribución por proyecto y genere el forecast para actualizar los totales.";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "No se pudo guardar la composición forecast {IdForecastEscenario}.", IdForecastEscenario);
            mensajeError = MensajeSeguro(ex);
        }
        finally
        {
            guardando = false;
        }
    }

    private async Task CargarConfiguracionAsync(string? idActor = null)
    {
        idActor ??= await ObtenerIdUsuarioActualAsync();
        configuracion = await ForecastParticipanteService.ObtenerConfiguracionAsync(
            IdForecastEscenario,
            idActor);
    }

    private bool EstaBloqueado(ParticipanteForecastConfigurado participante) =>
        configuracion?.PuedeEditar != true || (!participante.EsElegible && !participante.EstaIncluido);

    private static void CambiarInclusion(ParticipanteForecastConfigurado participante, ChangeEventArgs evento)
    {
        participante.EstaIncluido = evento.Value is bool valor && valor;
    }

    private async Task<string> ObtenerIdUsuarioActualAsync()
    {
        var estado = await Autenticacion.GetAuthenticationStateAsync();
        return estado.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value
            ?? throw new UnauthorizedAccessException("No fue posible autorizar la cuenta actual.");
    }

    private void LimpiarMensajes()
    {
        mensajeError = null;
        mensajeExito = null;
    }

    private static string TextoSalario(decimal? salario) =>
        salario.HasValue ? $"₡{salario:N2}" : "No disponible";

    private static string MensajeSeguro(Exception ex)
    {
        if (ex is ArgumentException argumento)
        {
            var indice = argumento.Message.LastIndexOf(" (", StringComparison.Ordinal);
            return indice >= 0 ? argumento.Message[..indice] : argumento.Message;
        }

        return ex is ValidationException or InvalidOperationException or KeyNotFoundException
            ? ex.Message
            : "No se pudo guardar la composición. Recargue los datos e intente nuevamente.";
    }
}
