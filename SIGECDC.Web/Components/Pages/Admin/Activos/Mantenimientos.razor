                </button>
            </div>
        </div>
    </div>
}

@code {
    private List<MantenimientoResumen> mantenimientos = [];
    private List<ActivoResumen> activos = [];
    private List<ProyectoResumen> proyectos = [];
    private List<EstadoMantenimientoOpcion> estados = [];

    private SolicitudRegistroMantenimiento formularioRegistro = new()
    {
        FechaProgramada = DateTime.Today
    };

    private SolicitudActualizarMantenimiento formularioActualizacion = new();

    private MantenimientoResumen? mantenimientoSeleccionado;

    private bool cargando = true;
    private bool guardando;
    private bool mostrarFormularioRegistro;
    private bool mostrarFormularioActualizacion;

    private string? mensajeExito;
    private string? mensajeErrorGlobal;
    private string? mensajeErrorModal;

    private string TextoCantidad => mantenimientos.Count == 1
        ? "1 mantenimiento"
        : $"{mantenimientos.Count} mantenimientos";

    protected override async Task OnInitializedAsync()
    {
        await CargarDatosAsync();
    }

    private async Task CargarDatosAsync()
    {
        cargando = true;
        mensajeErrorGlobal = null;

        try
        {
            var mantenimientosObtenidos =
                await MantenimientoService.ObtenerMantenimientosAsync();

            var activosObtenidos =
                await ActivoService.ObtenerActivosAsync();

            var proyectosObtenidos =
                await ProyectoService.ObtenerProyectosAsync();

            var estadosObtenidos =
                await MantenimientoService.ObtenerEstadosMantenimientoAsync();

            mantenimientos = [.. mantenimientosObtenidos];
            activos = [.. activosObtenidos];
            proyectos = [.. proyectosObtenidos];
            estados = [.. estadosObtenidos];
        }
        catch (Exception ex)
        {
            Logger.LogError(
                ex,
                "No se pudieron cargar los datos del módulo de mantenimientos.");

            mensajeErrorGlobal =
                "No se pudieron cargar los mantenimientos. Intente nuevamente.";
        }
        finally
        {
            cargando = false;
        }
    }

    private void AbrirFormularioNuevo()
    {
        formularioRegistro = new SolicitudRegistroMantenimiento
        {
            FechaProgramada = DateTime.Today
        };

        mensajeErrorModal = null;
        mensajeExito = null;
        mostrarFormularioRegistro = true;
    }

    private void CerrarFormularioRegistro()
    {
        mostrarFormularioRegistro = false;
        mensajeErrorModal = null;
    }

    private void AbrirFormularioEditar(
        MantenimientoResumen mantenimiento)
    {
        mantenimientoSeleccionado = mantenimiento;

        formularioActualizacion =
            new SolicitudActualizarMantenimiento
            {
                IdMantenimiento =
                    mantenimiento.IdMantenimiento,

                IdEstadoMantenimiento =
                    mantenimiento.IdEstadoMantenimiento,

                FechaInicio =
                    mantenimiento.FechaInicio,

                FechaFin =
                    mantenimiento.FechaFin,

                CostoReal =
                    mantenimiento.CostoReal,

                TiempoFueraServicioHoras =
                    mantenimiento.TiempoFueraServicioHoras,

                Resultado =
                    mantenimiento.Resultado,

                Descripcion =
                    mantenimiento.Descripcion,

                Responsable =
                    mantenimiento.Responsable
            };

        mensajeErrorModal = null;
        mensajeExito = null;
        mostrarFormularioActualizacion = true;
    }

    private void CerrarFormularioActualizacion()
    {
        mostrarFormularioActualizacion = false;
        mantenimientoSeleccionado = null;
        mensajeErrorModal = null;
    }

    private async Task GuardarNuevoMantenimiento()
    {
        mensajeErrorModal = null;
        mensajeExito = null;

        if (formularioRegistro.IdActivo <= 0)
        {
            mensajeErrorModal = "Seleccione un activo.";
            return;
        }

        if (string.IsNullOrWhiteSpace(
            formularioRegistro.TipoMantenimiento))
        {
            mensajeErrorModal =
                "Seleccione el tipo de mantenimiento.";
            return;
        }

        if (formularioRegistro.IdEstadoMantenimiento <= 0)
        {
            mensajeErrorModal =
                "Seleccione el estado del mantenimiento.";
            return;
        }

        guardando = true;

        try
        {
            var idUsuarioActual =
                await ObtenerIdUsuarioActualAsync();

            await MantenimientoService.RegistrarMantenimientoAsync(
                formularioRegistro,
                idUsuarioActual);

            mensajeExito =
                "Mantenimiento registrado correctamente.";

            mostrarFormularioRegistro = false;

            await CargarDatosAsync();
        }
        catch (ArgumentException ex)
        {
            mensajeErrorModal = ex.Message;
        }
        catch (InvalidOperationException ex)
        {
            mensajeErrorModal = ex.Message;
        }
        catch (Exception ex)
        {
            Logger.LogError(
                ex,
                "No se pudo registrar el mantenimiento.");

            mensajeErrorModal =
                "No se pudo registrar el mantenimiento. Intente nuevamente.";
        }
        finally
        {
            guardando = false;
        }
    }

    private async Task GuardarActualizacion()
    {
        mensajeErrorModal = null;
        mensajeExito = null;

        if (formularioActualizacion.IdMantenimiento <= 0)
        {
            mensajeErrorModal =
                "No se pudo identificar el mantenimiento.";
            return;
        }

        if (formularioActualizacion.IdEstadoMantenimiento <= 0)
        {
            mensajeErrorModal =
                "Seleccione el estado del mantenimiento.";
            return;
        }

        guardando = true;

        try
        {
            var idUsuarioActual =
                await ObtenerIdUsuarioActualAsync();

            await MantenimientoService.ActualizarMantenimientoAsync(
                formularioActualizacion,
                idUsuarioActual);

            mensajeExito =
                "Mantenimiento actualizado correctamente.";

            mostrarFormularioActualizacion = false;
            mantenimientoSeleccionado = null;

            await CargarDatosAsync();
        }
        catch (ArgumentException ex)
        {
            mensajeErrorModal = ex.Message;
        }
        catch (InvalidOperationException ex)
        {
            mensajeErrorModal = ex.Message;
        }
        catch (Exception ex)
        {
            Logger.LogError(
                ex,
                "No se pudo actualizar el mantenimiento {IdMantenimiento}.",
                formularioActualizacion.IdMantenimiento);

            mensajeErrorModal =
                "No se pudo actualizar el mantenimiento. Intente nuevamente.";
        }
        finally
        {
            guardando = false;
        }
    }

    private async Task<string> ObtenerIdUsuarioActualAsync()
    {
        var estadoAutenticacion =
            await Autenticacion.GetAuthenticationStateAsync();

        return estadoAutenticacion.User
            .FindFirst(
                System.Security.Claims.ClaimTypes.NameIdentifier)
            ?.Value
            ?? throw new InvalidOperationException(
                "No se pudo identificar al usuario actual.");
    }

    private static string FormatearMonto(decimal? monto)
    {
        return monto.HasValue
            ? $"₡{monto.Value:N2}"
            : "-";
    }

    private static string ObtenerClaseEstado(string estado)
    {
        return estado switch
        {
            "Programado" => "badge--info",
            "En proceso" => "badge--accent",
            "Finalizado" => "badge--success",
            "Cancelado" => "badge--ink",
            _ => "badge--ink"
        };
    }
}