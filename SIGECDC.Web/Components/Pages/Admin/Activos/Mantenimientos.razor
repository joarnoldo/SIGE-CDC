@page "/admin/activos/mantenimientos"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Administrador")]

@using Microsoft.AspNetCore.Components.Authorization
@using SIGECDC.Application.Activos
@using SIGECDC.Application.Operaciones

@inject IMantenimientoService MantenimientoService
@inject IActivoService ActivoService
@inject IProyectoService ProyectoService
@inject AuthenticationStateProvider Autenticacion
@inject ILogger<Mantenimientos> Logger

<PageTitle>Mantenimientos - SIGE-CDC</PageTitle>

<div class="page-frame">
    <div class="page-header">
        <div>
            <h1>Mantenimientos</h1>
            <p class="card__meta">
                Registre y actualice los mantenimientos preventivos y correctivos de los activos.
            </p>
        </div>

        <div class="page-actions">
            <button class="btn btn--primary"
                    type="button"
                    @onclick="AbrirFormularioNuevo">
                Nuevo mantenimiento
            </button>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(mensajeExito))
    {
        <div class="alert alert--success" role="status">
            @mensajeExito
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(mensajeErrorGlobal))
    {
        <div class="alert alert--danger" role="alert">
            @mensajeErrorGlobal
        </div>
    }

    @if (cargando)
    {
        <div class="empty-state">
            <strong>Cargando mantenimientos</strong>
            <p class="text-muted">
                Estamos recuperando la información registrada.
            </p>
        </div>
    }
    else if (mantenimientos.Count == 0)
    {
        <div class="empty-state">
            <strong>No hay mantenimientos registrados</strong>
            <p class="text-muted">
                Registre el primer mantenimiento de un activo.
            </p>

            <button class="btn btn--primary"
                    type="button"
                    @onclick="AbrirFormularioNuevo">
                Nuevo mantenimiento
            </button>
        </div>
    }
    else
    {
        <div class="table-card">
            <div class="table-toolbar">
                <div>
                    <h2 class="card__title">Listado de mantenimientos</h2>
                    <p class="card__meta">
                        Mantenimientos activos ordenados por fecha programada.
                    </p>
                </div>

                <span class="badge badge--info">
                    @TextoCantidad
                </span>
            </div>

            <div class="table-responsive">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Activo</th>
                            <th>Proyecto</th>
                            <th>Tipo</th>
                            <th>Fecha programada</th>
                            <th>Estado</th>
                            <th>Responsable</th>
                            <th>Costos</th>
                            <th>Acción</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var mantenimiento in mantenimientos)
                        {
                            <tr>
                                <td>
                                    <strong>@mantenimiento.Activo</strong>

                                    @if (!string.IsNullOrWhiteSpace(mantenimiento.Descripcion))
                                    {
                                        <p class="card__meta">
                                            @mantenimiento.Descripcion
                                        </p>
                                    }
                                </td>

                                <td>
                                    @(string.IsNullOrWhiteSpace(mantenimiento.Proyecto)
                                        ? "Sin proyecto"
                                        : mantenimiento.Proyecto)
                                </td>

                                <td>
                                    <span class="badge badge--ink">
                                        @mantenimiento.TipoMantenimiento
                                    </span>
                                </td>

                                <td>
                                    @mantenimiento.FechaProgramada.ToString("dd/MM/yyyy")
                                </td>

                                <td>
                                    <span class="badge @ObtenerClaseEstado(mantenimiento.EstadoMantenimiento)">
                                        @mantenimiento.EstadoMantenimiento
                                    </span>
                                </td>

                                <td>
                                    @(string.IsNullOrWhiteSpace(mantenimiento.Responsable)
                                        ? "-"
                                        : mantenimiento.Responsable)
                                </td>

                                <td>
                                    <div class="stack--tight">
                                        <span>
                                            Estimado:
                                            @FormatearMonto(mantenimiento.CostoEstimado)
                                        </span>

                                        <span>
                                            Real:
                                            @FormatearMonto(mantenimiento.CostoReal)
                                        </span>
                                    </div>
                                </td>

                                <td>
                                    <div class="table-actions">
                                        <button type="button"
                                                @onclick="() => AbrirFormularioEditar(mantenimiento)">
                                            Actualizar
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@if (mostrarFormularioRegistro)
{
    <div class="modal-backdrop-sige">
        <div class="card modal-card-sige">
            <div class="card__header">
                <h5 class="card__title">
                    Nuevo mantenimiento
                </h5>

                <button type="button"
                        class="btn-close"
                        @onclick="CerrarFormularioRegistro">
                </button>
            </div>

            @if (!string.IsNullOrWhiteSpace(mensajeErrorModal))
            {
                <div class="alert alert--danger" role="alert">
                    @mensajeErrorModal
                </div>
            }

            <div class="form-group">
                <label class="form-label">
                    Activo
                </label>

                <select class="form-select"
                        @bind="formularioRegistro.IdActivo">
                    <option value="0">
                        Seleccione un activo
                    </option>

                    @foreach (var activo in activos)
                    {
                        <option value="@activo.IdActivo">
                            @activo.CodigoActivo - @activo.NombreActivo
                        </option>
                    }
                </select>
            </div>

            <div class="form-group">
                <label class="form-label">
                    Proyecto
                </label>

                <select class="form-select"
                        @bind="formularioRegistro.IdProyecto">
                    <option value="">
                        Sin proyecto
                    </option>

                    @foreach (var proyecto in proyectos)
                    {
                        <option value="@proyecto.IdProyecto">
                            @proyecto.CodigoProyecto - @proyecto.NombreProyecto
                        </option>
                    }
                </select>
            </div>

            <div class="form-group">
                <label class="form-label">
                    Tipo de mantenimiento
                </label>

                <select class="form-select"
                        @bind="formularioRegistro.TipoMantenimiento">
                    <option value="">
                        Seleccione un tipo
                    </option>
                    <option value="Preventivo">
                        Preventivo
                    </option>
                    <option value="Correctivo">
                        Correctivo
                    </option>
                </select>
            </div>

            <div class="form-group">
                <label class="form-label">
                    Estado
                </label>

                <select class="form-select"
                        @bind="formularioRegistro.IdEstadoMantenimiento">
                    <option value="0">
                        Seleccione un estado
                    </option>

                    @foreach (var estado in estados)
                    {
                        <option value="@estado.IdEstadoMantenimiento">
                            @estado.Nombre
                        </option>
                    }
                </select>
            </div>

            <div class="form-group">
                <label class="form-label">
                    Fecha programada
                </label>

                <input class="form-control"
                       type="date"
                       @bind="formularioRegistro.FechaProgramada"
                       @bind:format="yyyy-MM-dd" />
            </div>

            <div class="form-group">
                <label class="form-label">
                    Fecha de inicio
                </label>

                <input class="form-control"
                       type="datetime-local"
                       @bind="formularioRegistro.FechaInicio"
                       @bind:format="yyyy-MM-ddTHH:mm" />
            </div>

            <div class="form-group">
                <label class="form-label">
                    Fecha de finalización
                </label>

                <input class="form-control"
                       type="datetime-local"
                       @bind="formularioRegistro.FechaFin"
                       @bind:format="yyyy-MM-ddTHH:mm" />
            </div>

            <div class="form-group">
                <label class="form-label">
                    Descripción
                </label>

                <textarea class="form-control"
                          rows="3"
                          maxlength="500"
                          @bind="formularioRegistro.Descripcion">
                </textarea>
            </div>

            <div class="form-group">
                <label class="form-label">
                    Costo estimado
                </label>

                <input class="form-control"
                       type="number"
                       min="0"
                       step="0.01"
                       @bind="formularioRegistro.CostoEstimado" />
            </div>

            <div class="form-group">
                <label class="form-label">
                    Costo real
                </label>

                <input class="form-control"
                       type="number"
                       min="0"
                       step="0.01"
                       @bind="formularioRegistro.CostoReal" />
            </div>

            <div class="form-group">
                <label class="form-label">
                    Tiempo fuera de servicio, en horas
                </label>

                <input class="form-control"
                       type="number"
                       min="0"
                       step="0.01"
                       @bind="formularioRegistro.TiempoFueraServicioHoras" />
            </div>

            <div class="form-group">
                <label class="form-label">
                    Responsable
                </label>

                <input class="form-control"
                       maxlength="150"
                       @bind="formularioRegistro.Responsable" />
            </div>

            <div class="form-group">
                <label class="form-label">
                    Resultado
                </label>

                <textarea class="form-control"
                          rows="3"
                          maxlength="500"
                          @bind="formularioRegistro.Resultado">
                </textarea>
            </div>

            <div class="form-actions">
                <button class="btn btn--secondary"
                        type="button"
                        @onclick="CerrarFormularioRegistro">
                    Cancelar
                </button>

                <button class="btn btn--primary"
                        type="button"
                        disabled="@guardando"
                        @onclick="GuardarNuevoMantenimiento">
                    @(guardando ? "Guardando..." : "Guardar")
                </button>
            </div>
        </div>
    </div>
}

