@page "/admin/galeria"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using SIGECDC.Application.SitioPublico
@inject IGaleriaService GaleriaService
@inject AuthenticationStateProvider Autenticacion
@inject ILogger<MultimediaGaleria> Logger
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Administrador")]

<PageTitle>Galería - SIGE-CDC</PageTitle>

<div class="page-frame">
    <div class="page-header">
        <h1>Galería</h1>
        <div class="page-actions">
            <button class="btn btn--primary" @onclick="AbrirFormularioNuevo">Nueva galería</button>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(mensajeExito))
    {
        <div class="alert alert--success" role="status">@mensajeExito</div>
    }

    @if (!string.IsNullOrWhiteSpace(mensajeErrorGlobal))
    {
        <div class="alert alert--danger" role="alert">@mensajeErrorGlobal</div>
    }

    @if (cargando)
    {
        <p>Cargando...</p>
    }
    else if (galerias.Count == 0)
    {
        <div class="empty-state">
            <p>No hay galerías registradas.</p>
            <button class="btn btn--primary" @onclick="AbrirFormularioNuevo">Nueva galería</button>
        </div>
    }
    else
    {
        <div class="table-card">
            <div class="table-responsive">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Nombre</th>
                            <th>Descripción</th>
                            <th>Imágenes</th>
                            <th>Estado</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var galeria in galerias)
                        {
                            <tr>
                                <td>@galeria.Nombre</td>
                                <td>@(galeria.Descripcion ?? "-")</td>
                                <td>@galeria.TotalImagenes</td>
                                <td>
                                    <span class="badge @(galeria.EstaPublicado ? "badge--success" : "badge--ink")">
                                        @(galeria.EstaPublicado ? "Publicada" : "No publicada")
                                    </span>
                                </td>
                                <td>
                                    <div class="table-actions">
                                        <button @onclick="() => AbrirFormularioEditar(galeria)">Editar</button>
                                        <button @onclick="() => AbrirImagenesAsync(galeria)">Imágenes</button>
                                        @if (galeria.EstaPublicado)
                                        {
                                            <button @onclick="() => Despublicar(galeria.IdGaleria)">Ocultar</button>
                                        }
                                        else
                                        {
                                            <button @onclick="() => Publicar(galeria.IdGaleria)">Publicar</button>
                                        }
                                        <button @onclick="() => Desactivar(galeria.IdGaleria)">Desactivar</button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    @if (galeriaSeleccionada is not null)
    {
        <section class="form-section mt-3">
            <div class="table-toolbar">
                <div>
                    <h2 class="card__title">Imágenes de @galeriaSeleccionada.Nombre</h2>
                    <p class="card__meta">Archivos públicos autorizados para esta galería.</p>
                </div>
                <button class="btn btn--secondary" type="button" @onclick="CerrarImagenes">Cerrar</button>
            </div>

            @if (!string.IsNullOrWhiteSpace(mensajeImagen))
            {
                <div class="alert alert--info">@mensajeImagen</div>
            }

            <div class="form-grid">
                <div class="field field--span-2">
                    <label>@(idImagenEditando == 0 ? "Archivo" : "Archivo de reemplazo (opcional)")</label>
                    <InputFile OnChange="SeleccionarImagen" accept=".jpg,.jpeg,.png" />
                    <span class="help-text">
                        @(idImagenEditando == 0
                            ? "Seleccione desde su equipo la imagen que desea cargar en esta galería."
                            : "Deje el archivo vacío para conservarlo o seleccione otro para reemplazarlo.")
                    </span>
                    <span class="help-text">@TextoArchivoImagen</span>
                </div>
                <div class="field">
                    <label>Título</label>
                    <input @bind="imagenFormulario.Titulo" @bind:event="oninput" maxlength="150" />
                </div>
                <div class="field">
                    <label>Orden</label>
                    <input type="number" min="0" @bind="imagenFormulario.Orden" @bind:event="oninput" />
                    <span class="help-text">Define la posición en que se mostrará la imagen dentro de la galería.</span>
                </div>
                <div class="field field--span-2">
                    <label>Descripción</label>
                    <textarea @bind="imagenFormulario.Descripcion" @bind:event="oninput" maxlength="300"></textarea>
                </div>
            </div>

            <div class="form-actions mt-3">
                <button class="btn btn--primary" type="button" @onclick="GuardarImagenAsync" disabled="@guardandoImagen">
                    @(guardandoImagen
                        ? "Guardando..."
                        : idImagenEditando == 0 ? "Adjuntar imagen" : "Guardar cambios")
                </button>
                @if (idImagenEditando != 0)
                {
                    <button class="btn btn--secondary" type="button" @onclick="CancelarEdicionImagen" disabled="@guardandoImagen">Cancelar edición</button>
                }
                <span class="help-text">Guarde el título, descripción y orden; el reemplazo mantiene la misma imagen lógica.</span>
            </div>

            @if (imagenes.Count == 0)
            {
                <div class="empty-state">
                    <strong>No hay imágenes asociadas</strong>
                    <p class="text-muted">Adjunte una imagen para enriquecer la galería pública.</p>
                </div>
            }
            else
            {
                <div class="content-grid mt-3">
                    @foreach (var imagen in imagenes)
                    {
                        <article class="card stack--tight">
                            <img class="media-thumb" src="@($"/admin/galeria/imagenes/{imagen.IdImagenGaleria}")" alt="@TextoAlternativo(imagen)" />
                            <h3>@(string.IsNullOrWhiteSpace(imagen.Titulo) ? imagen.NombreOriginal : imagen.Titulo)</h3>
                            <p>@(string.IsNullOrWhiteSpace(imagen.Descripcion) ? "Sin descripción" : imagen.Descripcion)</p>
                            <p class="card__meta">Orden @imagen.Orden · @FormatoTamano(imagen.TamanoBytes)</p>
                            <div class="table-actions">
                                <button type="button" @onclick="() => AbrirEditarImagen(imagen)">Editar</button>
                                <button type="button" @onclick="() => DesactivarImagenAsync(imagen.IdImagenGaleria)">Desactivar</button>
                            </div>
                        </article>
                    }
                </div>
            }
        </section>
    }
</div>

@if (mostrarFormulario)
{
    <div class="modal-backdrop-sige">
        <div class="card modal-card-sige">
            <div class="card__header">
                <h5 class="card__title">@(idEditando == 0 ? "Nueva galería" : "Editar galería")</h5>
                <button type="button" class="btn-close" @onclick="CerrarFormulario"></button>
            </div>

            @if (!string.IsNullOrWhiteSpace(mensajeErrorModal))
            {
                <div class="alert alert--danger" role="alert">@mensajeErrorModal</div>
            }

            <div class="form-group">
                <label class="form-label">Nombre</label>
                <input class="form-control" @bind="formulario.Nombre" maxlength="150" />
            </div>

            <div class="form-group">
                <label class="form-label">Descripción</label>
                <textarea class="form-control" @bind="formulario.Descripcion" rows="4" maxlength="500"></textarea>
            </div>

            <div class="form-actions">
                <button class="btn btn--secondary" @onclick="CerrarFormulario">Cancelar</button>
                <button class="btn btn--primary" @onclick="Guardar" disabled="@guardando">
                    @(guardando ? "Guardando..." : "Guardar")
                </button>
            </div>
        </div>
    </div>
}

@code {
    private List<GaleriaResumen> galerias = [];
    private bool cargando = true;
    private bool mostrarFormulario;
    private bool guardando;
    private bool guardandoImagen;
    private string? mensajeExito;
    private string? mensajeErrorGlobal;
    private string? mensajeErrorModal;
    private string? mensajeImagen;
    private SolicitudGaleria formulario = new();
    private SolicitudImagenGaleria imagenFormulario = new();
    private GaleriaResumen? galeriaSeleccionada;
    private IReadOnlyList<ImagenGaleriaResumen> imagenes = [];
    private IBrowserFile? archivoImagen;
    private long idEditando;
    private long idImagenEditando;
    private const long TamanoMaximoImagen = 10 * 1024 * 1024;

    private string TextoArchivoImagen => archivoImagen is null
        ? idImagenEditando == 0
            ? "Seleccione una imagen JPG o PNG de hasta 10 MB."
            : "Se conservará el archivo actual."
        : $"{archivoImagen.Name} · {FormatoTamano(archivoImagen.Size)}";

    protected override async Task OnInitializedAsync()
    {
        await CargarGalerias();
    }

    private async Task CargarGalerias()
    {
        cargando = true;
        try
        {
            galerias = [.. await GaleriaService.ObtenerTodasAdminAsync()];
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "No se pudieron cargar las galerías.");
            mensajeErrorGlobal = "No se pudieron cargar las galerías. Verifique la conexión e intente nuevamente.";
        }
        finally
        {
            cargando = false;
        }
    }

    private void AbrirFormularioNuevo()
    {
        idEditando = 0;
        formulario = new();
        mensajeErrorModal = null;
        mostrarFormulario = true;
    }

    private void AbrirFormularioEditar(GaleriaResumen galeria)
    {
        idEditando = galeria.IdGaleria;
        formulario = new SolicitudGaleria
        {
            Nombre = galeria.Nombre,
            Descripcion = galeria.Descripcion
        };
        mensajeErrorModal = null;
        mostrarFormulario = true;
    }

    private void CerrarFormulario()
    {
        mostrarFormulario = false;
        mensajeErrorModal = null;
    }

    private async Task Guardar()
    {
        if (string.IsNullOrWhiteSpace(formulario.Nombre))
        {
            mensajeErrorModal = "El nombre es obligatorio.";
            return;
        }

        guardando = true;
        mensajeErrorModal = null;

        try
        {
            if (idEditando == 0)
            {
                await GaleriaService.RegistrarAsync(formulario);
                mensajeExito = "Galería registrada correctamente.";
            }
            else
            {
                await GaleriaService.ActualizarAsync(idEditando, formulario);
                mensajeExito = "Galería actualizada correctamente.";
            }

            mostrarFormulario = false;
            await CargarGalerias();
        }
        catch (ArgumentException ex)
        {
            mensajeErrorModal = ex.Message;
        }
        catch (InvalidOperationException ex)
        {
            mensajeErrorModal = ex.Message;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "No se pudo guardar la galería {IdGaleria}.", idEditando);
            mensajeErrorModal = "No se pudo guardar la galería. Intente nuevamente.";
        }
        finally
        {
            guardando = false;
        }
    }

    private async Task Publicar(long idGaleria)
    {
        await EjecutarAccionAsync(() => GaleriaService.PublicarAsync(idGaleria), "Galería publicada correctamente.");
    }

    private async Task Despublicar(long idGaleria)
    {
        await EjecutarAccionAsync(() => GaleriaService.DespublicarAsync(idGaleria), "Galería ocultada correctamente.");
    }

    private async Task Desactivar(long idGaleria)
    {
        await EjecutarAccionAsync(() => GaleriaService.DesactivarAsync(idGaleria), "Galería desactivada correctamente.");
    }

    private async Task AbrirImagenesAsync(GaleriaResumen galeria)
    {
        galeriaSeleccionada = galeria;
        imagenFormulario = new SolicitudImagenGaleria { IdGaleria = galeria.IdGaleria };
        archivoImagen = null;
        idImagenEditando = 0;
        mensajeImagen = null;
        await CargarImagenesAsync();
    }

    private void CerrarImagenes()
    {
        galeriaSeleccionada = null;
        imagenes = [];
        archivoImagen = null;
        idImagenEditando = 0;
        mensajeImagen = null;
    }

    private void SeleccionarImagen(InputFileChangeEventArgs evento)
    {
        archivoImagen = evento.File;
        mensajeImagen = null;
    }

    private void AbrirEditarImagen(ImagenGaleriaResumen imagen)
    {
        idImagenEditando = imagen.IdImagenGaleria;
        imagenFormulario = new SolicitudImagenGaleria
        {
            IdGaleria = imagen.IdGaleria,
            Titulo = imagen.Titulo,
            Descripcion = imagen.Descripcion,
            Orden = imagen.Orden
        };
        archivoImagen = null;
        mensajeImagen = $"Editando {imagen.NombreOriginal}.";
    }

    private void CancelarEdicionImagen()
    {
        if (galeriaSeleccionada is null)
        {
            return;
        }

        idImagenEditando = 0;
        imagenFormulario = new SolicitudImagenGaleria
        {
            IdGaleria = galeriaSeleccionada.IdGaleria
        };
        archivoImagen = null;
        mensajeImagen = null;
    }

    private async Task GuardarImagenAsync()
    {
        if (galeriaSeleccionada is null)
        {
            return;
        }

        if (idImagenEditando == 0 && archivoImagen is null)
        {
            mensajeImagen = "Seleccione una imagen para adjuntar.";
            return;
        }

        guardandoImagen = true;
        mensajeImagen = null;

        try
        {
            if (idImagenEditando != 0 && archivoImagen is null)
            {
                await GaleriaService.ActualizarImagenAsync(
                    idImagenEditando,
                    new SolicitudActualizarImagenGaleria
                    {
                        Titulo = imagenFormulario.Titulo,
                        Descripcion = imagenFormulario.Descripcion,
                        Orden = imagenFormulario.Orden
                    },
                    await ObtenerIdUsuarioActualAsync());
                mensajeImagen = "Datos de la imagen actualizados correctamente.";
            }
            else
            {
                using var solicitud = new SolicitudImagenGaleria
                {
                    IdGaleria = galeriaSeleccionada.IdGaleria,
                    Titulo = imagenFormulario.Titulo,
                    Descripcion = imagenFormulario.Descripcion,
                    Orden = imagenFormulario.Orden,
                    NombreOriginal = archivoImagen!.Name,
                    MimeType = archivoImagen.ContentType,
                    TamanoBytes = archivoImagen.Size,
                    Contenido = archivoImagen.OpenReadStream(TamanoMaximoImagen)
                };

                if (idImagenEditando == 0)
                {
                    await GaleriaService.AdjuntarImagenAsync(
                        solicitud,
                        await ObtenerIdUsuarioActualAsync());
                    mensajeImagen = "Imagen adjuntada correctamente.";
                }
                else
                {
                    await GaleriaService.ReemplazarImagenAsync(
                        idImagenEditando,
                        solicitud,
                        await ObtenerIdUsuarioActualAsync());
                    mensajeImagen = "Imagen reemplazada correctamente.";
                }
            }

            idImagenEditando = 0;
            imagenFormulario = new SolicitudImagenGaleria { IdGaleria = galeriaSeleccionada.IdGaleria };
            archivoImagen = null;
            await CargarImagenesAsync();
            await CargarGalerias();
        }
        catch (ArgumentException ex)
        {
            mensajeImagen = ex.Message;
        }
        catch (InvalidOperationException ex)
        {
            mensajeImagen = ex.Message;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "No se pudo adjuntar una imagen a la galería {IdGaleria}.", galeriaSeleccionada.IdGaleria);
            mensajeImagen = "No se pudo adjuntar la imagen. Intente nuevamente.";
        }
        finally
        {
            guardandoImagen = false;
        }
    }

    private async Task DesactivarImagenAsync(long idImagenGaleria)
    {
        try
        {
            await GaleriaService.DesactivarImagenAsync(idImagenGaleria, await ObtenerIdUsuarioActualAsync());
            mensajeImagen = "Imagen desactivada correctamente.";
            if (idImagenEditando == idImagenGaleria)
            {
                idImagenEditando = 0;
                imagenFormulario = new SolicitudImagenGaleria
                {
                    IdGaleria = galeriaSeleccionada?.IdGaleria ?? 0
                };
                archivoImagen = null;
            }
            await CargarImagenesAsync();
            await CargarGalerias();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "No se pudo desactivar la imagen {IdImagenGaleria}.", idImagenGaleria);
            mensajeImagen = "No se pudo desactivar la imagen. Intente nuevamente.";
        }
    }

    private async Task CargarImagenesAsync()
    {
        if (galeriaSeleccionada is null)
        {
            imagenes = [];
            return;
        }

        try
        {
            imagenes = await GaleriaService.ObtenerImagenesAsync(galeriaSeleccionada.IdGaleria);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "No se pudieron cargar las imágenes de la galería {IdGaleria}.", galeriaSeleccionada.IdGaleria);
            imagenes = [];
            mensajeImagen = "No se pudieron cargar las imágenes de la galería.";
        }
    }

    private async Task<string?> ObtenerIdUsuarioActualAsync()
    {
        var estadoAutenticacion = await Autenticacion.GetAuthenticationStateAsync();
        return estadoAutenticacion.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    }

    private async Task EjecutarAccionAsync(Func<Task> accion, string mensaje)
    {
        try
        {
            await accion();
            mensajeExito = mensaje;
            await CargarGalerias();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "No se pudo completar una acción sobre la galería.");
            mensajeErrorGlobal = "No se pudo completar la acción sobre la galería. Intente nuevamente.";
        }
    }

    private static string TextoAlternativo(ImagenGaleriaResumen imagen)
    {
        return string.IsNullOrWhiteSpace(imagen.Titulo) ? imagen.NombreOriginal : imagen.Titulo;
    }

    private static string FormatoTamano(long? tamanoBytes)
    {
        if (tamanoBytes is null)
        {
            return "-";
        }

        return tamanoBytes < 1024 * 1024
            ? $"{tamanoBytes.Value / 1024.0:N1} KB"
            : $"{tamanoBytes.Value / (1024.0 * 1024.0):N1} MB";
    }
}
