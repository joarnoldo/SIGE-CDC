@page "/rrhh/departamentos"
@using Microsoft.AspNetCore.Authorization
@using SIGECDC.Application.RecursosHumanos
@inject IDepartamentoService DepartamentoService
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Administrador,Recursos Humanos")]

<PageTitle>Departamentos - SIGE-CDC</PageTitle>

<div class="page-frame">
    <div class="page-header">
        <h1>Departamentos</h1>
        <div class="page-actions">
            <button class="btn btn--primary" @onclick="AbrirFormularioNuevo">Nuevo departamento</button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(mensajeExito))
    {
        <div class="alert alert--success" role="status">@mensajeExito</div>
    }

    @if (!string.IsNullOrEmpty(mensajeErrorGlobal))
    {
        <div class="alert alert--danger" role="alert">@mensajeErrorGlobal</div>
    }

    @if (cargando)
    {
        <p>Cargando...</p>
    }
    else if (departamentos.Count == 0)
    {
        <div class="empty-state">
            <p>No hay departamentos registrados.</p>
            <button class="btn btn--primary" @onclick="AbrirFormularioNuevo">Nuevo departamento</button>
        </div>
    }
    else
    {
        <div class="table-card">
            <div class="table-responsive">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Nombre</th>
                            <th>Descripcion</th>
                            <th>Colaboradores activos</th>
                            <th>Estado</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var departamento in departamentos)
                        {
                            <tr>
                                <td>@departamento.Nombre</td>
                                <td>@(departamento.Descripcion ?? "-")</td>
                                <td>@departamento.TotalColaboradores</td>
                                <td>
                                    <span class="badge @(departamento.EstadoRegistro == "Activo" ? "badge--success" : "badge--ink")">
                                        @departamento.EstadoRegistro
                                    </span>
                                </td>
                                <td>
                                    <div class="table-actions">
                                        <button @onclick="() => AbrirFormularioEditar(departamento)">Editar</button>
                                        @if (departamento.EstadoRegistro == "Activo")
                                        {
                                            <button @onclick="() => Desactivar(departamento.IdDepartamento)">Desactivar</button>
                                        }
                                        else
                                        {
                                            <button @onclick="() => Activar(departamento.IdDepartamento)">Activar</button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@if (mostrarFormulario)
{
    <div class="modal-backdrop-sige">
        <div class="card modal-card-sige">
            <div class="card__header">
                <h5 class="card__title">@(esNuevo ? "Nuevo departamento" : "Editar departamento")</h5>
                <button type="button" class="btn-close" @onclick="CerrarFormulario"></button>
            </div>

            @if (!string.IsNullOrEmpty(mensajeErrorModal))
            {
                <div class="alert alert--danger" role="alert">@mensajeErrorModal</div>
            }

            <div class="form-group">
                <label class="form-label">Nombre</label>
                <input class="form-control" @bind="formulario.Nombre" maxlength="100" />
            </div>

            <div class="form-group">
                <label class="form-label">Descripcion</label>
                <textarea class="form-control" @bind="formulario.Descripcion" rows="3" maxlength="255"></textarea>
            </div>

            <div class="form-actions">
                <button class="btn btn--secondary" @onclick="CerrarFormulario">Cancelar</button>
                <button class="btn btn--primary" @onclick="Guardar" disabled="@guardando">
                    @(guardando ? "Guardando..." : "Guardar")
                </button>
            </div>
        </div>
    </div>
}

@code {
    private List<DepartamentoResumen> departamentos = [];
    private bool cargando = true;
    private bool mostrarFormulario;
    private bool esNuevo = true;
    private bool guardando;
    private string? mensajeExito;
    private string? mensajeErrorGlobal;
    private string? mensajeErrorModal;
    private FormularioDepartamento formulario = new();
    private int idEditando;

    protected override async Task OnInitializedAsync()
    {
        await CargarDepartamentos();
    }

    private async Task CargarDepartamentos()
    {
        cargando = true;
        try
        {
            departamentos = [.. await DepartamentoService.ObtenerTodosAsync()];
        }
        catch (Exception ex)
        {
            mensajeErrorGlobal = $"Error al cargar datos: {ex.Message}";
        }
        finally
        {
            cargando = false;
        }
    }

    private void AbrirFormularioNuevo()
    {
        esNuevo = true;
        formulario = new();
        idEditando = 0;
        mensajeErrorModal = null;
        mostrarFormulario = true;
    }

    private void AbrirFormularioEditar(DepartamentoResumen departamento)
    {
        esNuevo = false;
        idEditando = departamento.IdDepartamento;
        formulario = new FormularioDepartamento
        {
            Nombre = departamento.Nombre,
            Descripcion = departamento.Descripcion
        };
        mensajeErrorModal = null;
        mostrarFormulario = true;
    }

    private void CerrarFormulario()
    {
        mostrarFormulario = false;
        mensajeErrorModal = null;
    }

    private async Task Guardar()
    {
        if (string.IsNullOrWhiteSpace(formulario.Nombre))
        {
            mensajeErrorModal = "El nombre es obligatorio.";
            return;
        }

        guardando = true;
        mensajeErrorModal = null;

        try
        {
            if (esNuevo)
            {
                await DepartamentoService.RegistrarAsync(new SolicitudRegistrarDepartamento
                {
                    Nombre = formulario.Nombre,
                    Descripcion = formulario.Descripcion
                });
                mensajeExito = "Departamento registrado correctamente.";
            }
            else
            {
                await DepartamentoService.ActualizarAsync(new SolicitudActualizarDepartamento
                {
                    IdDepartamento = idEditando,
                    Nombre = formulario.Nombre,
                    Descripcion = formulario.Descripcion
                });
                mensajeExito = "Departamento actualizado correctamente.";
            }

            mostrarFormulario = false;
            await CargarDepartamentos();
        }
        catch (Exception ex)
        {
            mensajeErrorModal = ex.Message;
        }
        finally
        {
            guardando = false;
        }
    }

    private async Task Desactivar(int idDepartamento)
    {
        await EjecutarAccionAsync(() => DepartamentoService.DesactivarAsync(idDepartamento), "Departamento desactivado correctamente.");
    }

    private async Task Activar(int idDepartamento)
    {
        await EjecutarAccionAsync(() => DepartamentoService.ActivarAsync(idDepartamento), "Departamento activado correctamente.");
    }

    private async Task EjecutarAccionAsync(Func<Task> accion, string mensaje)
    {
        try
        {
            await accion();
            mensajeExito = mensaje;
            await CargarDepartamentos();
        }
        catch (Exception ex)
        {
            mensajeErrorGlobal = ex.Message;
        }
    }

    private sealed class FormularioDepartamento
    {
        public string Nombre { get; set; } = string.Empty;
        public string? Descripcion { get; set; }
    }
}