@page "/admin/consultas-contacto"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Administrador")]
@using SIGECDC.Application.SitioPublico
@inject IConsultaContactoService ConsultaContactoService
@inject ILogger<ConsultasContacto> Logger

<PageTitle>Consultas de contacto | SIGE-CDC</PageTitle>

<section class="page-banner">
    <div class="container page-banner__inner stack--tight">
        <p class="eyebrow">Administración</p>
        <h1>Consultas de contacto recibidas.</h1>
        <p class="lead">Revise, clasifique y dé seguimiento a las solicitudes enviadas desde el formulario público de contacto.</p>
    </div>
</section>

<section class="section-shell">
    <div class="container stack">
        @if (!string.IsNullOrWhiteSpace(mensajeEstado))
        {
            <div class="alert alert-@(mensajeEsError ? "danger" : "success")" role="alert">
                @mensajeEstado
            </div>
        }

        <article class="table-card">
            <div class="table-toolbar">
                <div>
                    <h2 class="card__title">Bandeja de contacto</h2>
                    <p class="card__meta">Solicitudes activas ordenadas desde la más reciente.</p>
                </div>
                <span class="badge badge--info">@TextoCantidad</span>
            </div>

            @if (cargando)
            {
                <div class="empty-state">
                    <strong>Cargando consultas</strong>
                    <p class="text-muted">Estamos recuperando la información registrada.</p>
                </div>
            }
            else if (consultas.Count == 0)
            {
                <div class="empty-state">
                    <strong>No hay consultas registradas</strong>
                    <p class="text-muted">Cuando el formulario público reciba solicitudes, aparecerán en esta bandeja.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Fecha</th>
                                <th>Contacto</th>
                                <th>Asunto</th>
                                <th>Mensaje</th>
                                <th>Estado</th>
                                <th>Acción</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var consulta in consultas)
                            {
                                <tr>
                                    <td>@consulta.FechaEnvio.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>
                                        <strong>@consulta.Nombre</strong>
                                        <p class="card__meta">@consulta.CorreoElectronico</p>
                                        @if (!string.IsNullOrWhiteSpace(consulta.Telefono))
                                        {
                                            <small>@consulta.Telefono</small>
                                        }
                                    </td>
                                    <td>@(string.IsNullOrWhiteSpace(consulta.Asunto) ? "Sin asunto" : consulta.Asunto)</td>
                                    <td>@consulta.Mensaje</td>
                                    <td>
                                        <div class="stack--tight">
                                            <span class="badge badge--accent">@ObtenerEtiquetaEstado(consulta.EstadoConsulta)</span>
                                            <select class="form-select"
                                                    value="@ObtenerEstadoSeleccionado(consulta.IdConsultaContacto)"
                                                    @onchange="evento => CambiarEstadoSeleccionado(consulta.IdConsultaContacto, evento)">
                                                @foreach (var estado in estadosConsulta)
                                                {
                                                    <option value="@estado.Valor">@estado.Etiqueta</option>
                                                }
                                            </select>
                                        </div>
                                    </td>
                                    <td>
                                        <button class="btn btn--secondary"
                                                type="button"
                                                disabled="@NoPuedeGuardarEstado(consulta)"
                                                @onclick="() => GuardarEstadoAsync(consulta)">
                                            @(consultaGuardando == consulta.IdConsultaContacto ? "Guardando" : "Guardar")
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </article>
    </div>
</section>

@code {
    private IReadOnlyList<ConsultaContactoResumen> consultas = [];
    private IReadOnlyList<EstadoConsultaContactoOpcion> estadosConsulta = [];
    private Dictionary<long, string> estadosSeleccionados = [];
    private bool cargando = true;
    private bool mensajeEsError;
    private long? consultaGuardando;
    private string? mensajeEstado;

    private string TextoCantidad => consultas.Count == 1
        ? "1 consulta"
        : $"{consultas.Count} consultas";

    protected override async Task OnInitializedAsync()
    {
        estadosConsulta = ConsultaContactoService.ObtenerEstadosConsulta();
        await CargarConsultasAsync();
    }

    private async Task CargarConsultasAsync()
    {
        cargando = true;
        consultas = await ConsultaContactoService.ObtenerConsultasRecientesAsync();
        estadosSeleccionados = consultas.ToDictionary(
            consulta => consulta.IdConsultaContacto,
            consulta => consulta.EstadoConsulta);
        cargando = false;
    }

    private string ObtenerEstadoSeleccionado(long idConsultaContacto)
    {
        return estadosSeleccionados.TryGetValue(idConsultaContacto, out var estado)
            ? estado
            : string.Empty;
    }

    private string ObtenerEtiquetaEstado(string estadoConsulta)
    {
        return estadosConsulta.FirstOrDefault(estado => estado.Valor == estadoConsulta)?.Etiqueta
            ?? estadoConsulta;
    }

    private void CambiarEstadoSeleccionado(long idConsultaContacto, ChangeEventArgs evento)
    {
        var nuevoEstado = evento.Value?.ToString();

        if (!string.IsNullOrWhiteSpace(nuevoEstado))
        {
            estadosSeleccionados[idConsultaContacto] = nuevoEstado;
        }
    }

    private bool NoPuedeGuardarEstado(ConsultaContactoResumen consulta)
    {
        if (consultaGuardando is not null)
        {
            return true;
        }

        return !estadosSeleccionados.TryGetValue(consulta.IdConsultaContacto, out var estadoSeleccionado)
            || estadoSeleccionado == consulta.EstadoConsulta;
    }

    private async Task GuardarEstadoAsync(ConsultaContactoResumen consulta)
    {
        if (!estadosSeleccionados.TryGetValue(consulta.IdConsultaContacto, out var estadoSeleccionado))
        {
            return;
        }

        mensajeEstado = null;
        mensajeEsError = false;
        consultaGuardando = consulta.IdConsultaContacto;

        try
        {
            await ConsultaContactoService.ActualizarEstadoConsultaAsync(consulta.IdConsultaContacto, estadoSeleccionado);
            mensajeEstado = $"El estado de la consulta de {consulta.Nombre} fue actualizado a {ObtenerEtiquetaEstado(estadoSeleccionado)}.";
            await CargarConsultasAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "No se pudo actualizar el estado de la consulta de contacto {IdConsultaContacto}.", consulta.IdConsultaContacto);
            mensajeEsError = true;
            mensajeEstado = "No se pudo actualizar el estado de la consulta. Intente nuevamente.";
        }
        finally
        {
            consultaGuardando = null;
        }
    }
}
